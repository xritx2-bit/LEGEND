# ==========================================
# Discord Bot Credentials
# ==========================================
# Get your bot token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# (Optional) Guild ID for instant slash command registration during development.
# Leave blank to register commands globally (can take up to 1 hour to propagate globally).
DISCORD_GUILD_ID=

# ==========================================
# YouTube Data API Credentials
# ==========================================
# Google Cloud Console > YouTube Data API v3 > Credentials > API Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your channel ID (usually starts with UC...)
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# Livestream polling interval in seconds (default: 300 seconds = 5 minutes)
YOUTUBE_POLL_INTERVAL=300

# ==========================================
# Application Configuration
# ==========================================
# SQLite database storage path
DATABASE_PATH=data/bot_database.db

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

